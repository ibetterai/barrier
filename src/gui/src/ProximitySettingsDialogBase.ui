      <item><widget class="QLabel" name="signalSharingInfoLabel"><property name="text"><string>When enabled, this client advertises an opaque pair-scoped routing ID over Bluetooth while Barrier is running. Nearby devices can link that Bluetooth signal to this client’s local Bonjour record; it is never used for authentication.</string></property><property name="wordWrap"><bool>true</bool></property><property name="minimumHeight"><number>80</number></property></widget></item>
