      <item><widget class="QLabel" name="thresholdHelpLabel"><property name="text"><string>Set the signal range for this pairing. A less-negative value is stronger. The departure threshold starts the sustained-departure countdown and must remain at least 15 dB weaker than the connect threshold.</string></property><property name="wordWrap"><bool>true</bool></property><property name="minimumHeight"><number>80</number></property></widget></item>
