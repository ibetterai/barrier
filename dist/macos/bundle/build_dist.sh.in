#!/bin/bash

# Use the same verbose variable as CMake
[ "$VERBOSE" = "1" ] && set -x

# Exit on unset variables or pipe errors
set -uo pipefail

B_MACOS="Barrier.app/Contents/MacOS"
B_VERSION="@BARRIER_VERSION@"
B_BINDIR="@CMAKE_RUNTIME_OUTPUT_DIRECTORY@"
B_BUILDTYPE="@CMAKE_BUILD_TYPE@"
B_DEPLOYQT="@BARRIER_MACDEPLOYQT_EXECUTABLE@"
B_DEPLOYMENT_TARGET="@BARRIER_MACOS_DEPLOYMENT_TARGET@"
B_ARCH="@CMAKE_OSX_ARCHITECTURES@"
B_RELEASE_AUDIT="@BARRIER_MACOS_RELEASE_AUDIT@"
B_VERIFY_SCRIPT="@BARRIER_MACOS_VERIFY_SCRIPT@"
B_MANIFEST="Barrier.app/Contents/Resources/macho-manifest.txt"
B_DMG="Barrier-$B_VERSION.dmg"
B_BARRIERC="Barrier.app/Contents/MacOS/barrierc"
B_BARRIERS="Barrier.app/Contents/MacOS/barriers"

# Colorized output
info() { tput bold 2>/dev/null || true; echo "$@"; tput sgr0 2>/dev/null || true ; }
error() { tput bold 2>/dev/null || true; tput setaf 1 2>/dev/null || true; echo "$@"; tput sgr0 2>/dev/null || true ; }
success() { tput bold 2>/dev/null || true; tput setaf 2 2>/dev/null || true; echo "$@"; tput sgr0 2>/dev/null || true ; }
warn() { tput bold 2>/dev/null || true; tput setaf 3 2>/dev/null || true; echo "$@"; tput sgr0 2>/dev/null || true ; }

audit_bundle() {
    if [ "$B_RELEASE_AUDIT" != "ON" ]; then
        warn "Public-release bundle audit is disabled"
        return 0
    fi

    info "Auditing bundled Mach-O files"
    bash "$B_VERIFY_SCRIPT" --app Barrier.app \
        --target "$B_DEPLOYMENT_TARGET" \
        --arch "$B_ARCH" \
        --manifest "$B_MANIFEST"
}

info "Checking for bundle contents"
if [ ! -d "Barrier.app/Contents" ]; then
    error "Please make sure that the build completed successfully"
    error "before trying to create the installer."
    exit 1
fi

if [ -d "$B_MACOS" ]; then
    info "Removing old binaries from bundle"
    rm -r "$B_MACOS"
fi

info "Copying binaries into bundle"
rm -f "$B_MANIFEST"
rm -f "$B_DMG"
mkdir -p "$B_MACOS" || exit 1
for B_BINARY in barrier barriers barrierc; do
    if [ ! -x "$B_BINDIR/$B_BINARY" ]; then
        error "Missing executable: $B_BINDIR/$B_BINARY"
        exit 1
    fi

    cp "$B_BINDIR/$B_BINARY" "$B_MACOS/$B_BINARY" || exit 1
done

if [ ! -x "$B_DEPLOYQT" ]; then
    error "Configured macdeployqt is not executable: $B_DEPLOYQT"
    exit 1
fi

# Run macdeployqt without -dmg so the complete app can be audited, when
# requested, before signing or disk-image creation.
if [ "$B_BUILDTYPE" = "Release" ]; then
    "$B_DEPLOYQT" Barrier.app \
    -executable="$B_BARRIERC" \
    -executable="$B_BARRIERS" || exit 1

    audit_bundle || exit 1

    info "Building Release disk image (dmg)"
    B_DMG_STAGING="$(mktemp -d "${TMPDIR:-/tmp}/barrier-dmg.XXXXXX")" || exit 1
    if ! ditto Barrier.app "$B_DMG_STAGING/Barrier.app"; then
        rm -r "$B_DMG_STAGING"
        exit 1
    fi
    ln -s /Applications "$B_DMG_STAGING/Applications" || {
        rm -r "$B_DMG_STAGING"
        exit 1
    }
    if ! hdiutil create -volname Barrier -srcfolder "$B_DMG_STAGING" \
        -ov -format UDZO "$B_DMG"; then
        rm -r "$B_DMG_STAGING"
        exit 1
    fi
    rm -r "$B_DMG_STAGING"
    success "Created $B_DMG"
else
    warn "Disk image (dmg) only created for Release builds"
    info "Building debug bundle"
    "$B_DEPLOYQT" Barrier.app -no-strip \
    -executable="$B_BARRIERC" \
    -executable="$B_BARRIERS" || exit 1

    audit_bundle || exit 1
    success "Bundle created successfully"
fi
